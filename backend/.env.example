DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Test database URL must be separate from DATABASE_URL to prevent dev data loss
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promptbench_test
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
JWT_SECRET_KEY=replace-with-a-long-random-secret
RUN_LLM_TESTS=false
RATE_LIMIT_MESSAGE=30/minute
RATE_LIMIT_SUBMIT=10/minute
JUDGE_RUNS=3
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
